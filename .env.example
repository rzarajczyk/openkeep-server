# Copy this file to .env, then replace every CHANGE_ME value before starting.
# Generate secrets with: openssl rand -base64 32
#
# Used by: local Compose, and infra/gcp/setup.sh (Cloud Run + Neon).

OWNKEEP_PORT=8080

# --- Postgres (single URL — paste Neon "connection string" as-is) ---
# Replaces the old POSTGRES_DB / POSTGRES_USER / POSTGRES_PASSWORD trio.
# Local Compose: host must be "db". Example:
OWNKEEP_DATABASE_URL=postgresql://ownkeep:CHANGE_ME_use_a_unique_random_database_password@db:5432/ownkeep
# Neon example (paste the console connection string as-is):
# OWNKEEP_DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# Migration from older .env files:
#   OWNKEEP_DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}

# Bootstrap first admin only; afterwards manage users in the app.
# Keep these on one line. Single quotes preserve literal '$' in passwords.
OWNKEEP_ADMIN_USERNAME=admin
OWNKEEP_ADMIN_PASSWORD=CHANGE_ME_use_a_long_unique_admin_password

# ISO-8601 duration (for example PT12H or P7D).
OWNKEEP_TOKEN_TTL=PT24H

# Attachments: 25 MiB per file, 26 MiB multipart ceiling, 1 GiB per-user quota.
OWNKEEP_ATTACHMENT_MAX_FILE_SIZE=26214400
OWNKEEP_MULTIPART_MAX_REQUEST_SIZE=27262976
OWNKEEP_ATTACHMENT_PER_USER_QUOTA=1073741824

# Attachment blob backend: filesystem (local Compose default) or gcs.
# Cloud Run (OpenTofu) sets these on the service; uncomment for local GCS testing.
# OWNKEEP_ATTACHMENT_STORAGE=filesystem
# OWNKEEP_ATTACHMENT_STORAGE_ROOT=./data/attachments
# OWNKEEP_ATTACHMENT_STORAGE=gcs
# OWNKEEP_ATTACHMENT_GCS_BUCKET=your-bucket-name
# OWNKEEP_ATTACHMENT_GCS_PREFIX=ownkeep/

# --- GCP (infra/gcp/setup.sh) ---
GCP_PROJECT_ID=openkeep-504806
GCP_REGION=europe-west1
# OWNKEEP_IMAGE=docker.io/rzarajczyk/ownkeep:latest
